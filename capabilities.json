{
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://tiles.openfreemap.org"
            ]
        }
    ],
    "dataRoles": [
        { "displayName": "Latitude départ", "name": "latStart", "kind": "Grouping" },
        { "displayName": "Longitude départ", "name": "lonStart", "kind": "Grouping" },
        { "displayName": "Latitude arrivée", "name": "latEnd", "kind": "Grouping" },
        { "displayName": "Longitude arrivée", "name": "lonEnd", "kind": "Grouping" },
        { "displayName": "Valeur quantitative", "name": "value", "kind": "Measure" },
        { "displayName": "Identifiant du flux", "name": "flowId", "kind": "Grouping" },
        { "displayName": "Catégorie", "name": "category", "kind": "Grouping" }
    ],
    "objects": {
        "map": {
            "displayName": "Carte",
            "properties": {
                "styleUrl": {
                    "displayName": "URL du style",
                    "type": { "text": true }
                },
                "initialZoom": {
                    "displayName": "Zoom initial",
                    "type": { "numeric": true }
                },
                "autoZoom": {
                    "displayName": "Zoom automatique",
                    "type": { "bool": true }
                }
            }
        },
        "arrows": {
            "displayName": "Flèches",
            "properties": {
                "color": {
                    "displayName": "Couleur",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "opacity": {
                    "displayName": "Opacité (%)",
                    "type": { "numeric": true }
                },
                "dimOpacity": {
                    "displayName": "Opacité des flux non sélectionnés (%)",
                    "type": { "numeric": true }
                },
                "curvature": {
                    "displayName": "Courbure (%)",
                    "type": { "numeric": true }
                },
                "endGap": {
                    "displayName": "Distance à la coordonnée (px)",
                    "type": { "numeric": true }
                },
                "dynamicGap": {
                    "displayName": "Écart dynamique (arrivées groupées)",
                    "type": { "bool": true }
                },
                "minThickness": {
                    "displayName": "Épaisseur minimale (px)",
                    "type": { "numeric": true }
                },
                "maxThickness": {
                    "displayName": "Épaisseur maximale (px)",
                    "type": { "numeric": true }
                },
                "scale": {
                    "displayName": "Échelle d'épaisseur",
                    "type": {
                        "enumeration": [
                            { "value": "sqrt", "displayName": "Racine carrée" },
                            { "value": "linear", "displayName": "Linéaire" },
                            { "value": "log", "displayName": "Logarithmique" }
                        ]
                    }
                },
                "maxFlows": {
                    "displayName": "Nombre maximal de flux",
                    "type": { "numeric": true }
                }
            }
        },
        "labels": {
            "displayName": "Étiquettes",
            "properties": {
                "show": {
                    "displayName": "Afficher les valeurs",
                    "type": { "bool": true }
                },
                "fontSize": {
                    "displayName": "Taille du texte (px)",
                    "type": { "numeric": true }
                },
                "minLength": {
                    "displayName": "Longueur minimale du flux (px)",
                    "type": { "numeric": true }
                }
            }
        },
        "debug": {
            "displayName": "Diagnostic",
            "properties": {
                "showDiagnostics": {
                    "displayName": "Afficher le diagnostic",
                    "type": { "bool": true }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "latStart" } },
                        { "for": { "in": "lonStart" } },
                        { "for": { "in": "latEnd" } },
                        { "for": { "in": "lonEnd" } },
                        { "for": { "in": "value" } },
                        { "for": { "in": "flowId" } },
                        { "for": { "in": "category" } }
                    ],
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                }
            }
        }
    ]
}
