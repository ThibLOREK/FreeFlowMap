{
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://tiles.openfreemap.org"
            ]
        }
    ],
    "dataRoles": [
        { "displayName": "Latitude départ", "name": "latStart", "kind": "Grouping" },
        { "displayName": "Longitude départ", "name": "lonStart", "kind": "Grouping" },
        { "displayName": "Latitude arrivée", "name": "latEnd", "kind": "Grouping" },
        { "displayName": "Longitude arrivée", "name": "lonEnd", "kind": "Grouping" },
        { "displayName": "Valeur quantitative", "name": "value", "kind": "Measure" },
        { "displayName": "Identifiant du flux", "name": "flowId", "kind": "Grouping" },
        { "displayName": "Catégorie", "name": "category", "kind": "Grouping" }
    ],
    "objects": {
        "map": {
            "displayName": "Carte",
            "properties": {
                "styleUrl": {
                    "displayName": "URL du style",
                    "type": { "text": true }
                },
                "initialZoom": {
                    "displayName": "Zoom initial",
                    "type": { "numeric": true }
                },
                "autoZoom": {
                    "displayName": "Zoom automatique",
                    "type": { "bool": true }
                }
            }
        },
        "arrows": {
            "displayName": "Flèches",
            "properties": {
                "color": {
                    "displayName": "Couleur",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "opacity": {
                    "displayName": "Opacité (%)",
                    "type": { "numeric": true }
                },
                "curvature": {
                    "displayName": "Courbure (%)",
                    "type": { "numeric": true }
                },
                "maxFlows": {
                    "displayName": "Nombre maximal de flux",
                    "type": { "numeric": true }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "latStart" } },
                        { "for": { "in": "lonStart" } },
                        { "for": { "in": "latEnd" } },
                        { "for": { "in": "lonEnd" } },
                        { "for": { "in": "value" } },
                        { "for": { "in": "flowId" } },
                        { "for": { "in": "category" } }
                    ],
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                }
            }
        }
    ]
}
